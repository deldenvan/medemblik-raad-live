# Bron: de Notubiz-livepagina, of een directe .m3u8-link uit de speler
STREAM_URL=https://medemblik.raadsinformatie.nl/live
RETRY_SECONDS=60

# whisper of mock (mock = nepzinnen, om de website te testen zonder model)
TRANSCRIBER=whisper
# large-v3-turbo = beste kwaliteit; small of medium voor een trage computer
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
# int8 is snel op een gewone processor; float16 op een NVIDIA-videokaart
WHISPER_COMPUTE=int8
LANGUAGE=nl
# Processorkernen voor Whisper (0 = automatisch)
WHISPER_THREADS=0

STEP_SECONDS=4
MAX_BUFFER_SECONDS=25
HOST=0.0.0.0
PORT=8000
# Valt de stream korter weg dan dit, dan gaat dezelfde vergadering verder
SESSION_GAP_MINUTES=30
TITLE=Gemeenteraad Medemblik – live meelezen
